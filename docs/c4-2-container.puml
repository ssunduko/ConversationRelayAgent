@startuml c4-2-container
' C4 Level 2 — Containers
' Render:  plantuml docs/c4-2-container.puml
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()
SHOW_PERSON_OUTLINE()
LAYOUT_TOP_DOWN()

title Containers — Salesmessage Answering Service

Person(member, "Salesmessage team member", "Inbound caller, PIN-gated")
Person(prospect, "Prospect", "Outbound demo call")
Person(operator, "Operator")

System_Boundary(sys, "Salesmessage Answering Service") {
    Container(app, "Relay application", "Python 3, FastAPI, uvicorn", "One process. Serves /twiml, /handoff, /ws, the dialpad endpoints and /health. Holds live conversation state in memory, keyed to the WebSocket.")
    Container(browser, "WebMCP browser", "Headless Chromium, Playwright", "Optional (WEBMCP_ENABLED). One page kept open on the logged-in web app, warmed at startup; the app's WebMCP tools are called through it.")
    Container(dialpad_ui, "Dialpad", "Static HTML + JS (app/static/dialpad.html)", "Type a number, place a demo call, watch it ring, hang up.")
    Container(explorer_ui, "Index explorer", "Static HTML, generated by scripts/visualize_index.py", "Projected view of the knowledge vectors, served at /explore.")
    Container(scripts, "Operator scripts", "Python CLI (scripts/)", "OAuth flow, web-app login, Twilio setup, preflight, index build, benchmarks, transcript fetch.")

    ContainerDb(features, "Feature catalogue", "JSON (data/features.json)", "Product features with a file-level generated date. Source for both the Voyage index and the Zep catalogue graph.")
    ContainerDb(sqlite, "Caller store", "SQLite (db/answering_service.db)", "Demo dialer only: callers, conversations, appointments. Written on a worker thread so a slow disk never stalls a live call.")
    ContainerDb(index, "Knowledge index", "NumPy .npz + JSON", "Demo dialer only. L2-normalized document vectors and their text. Built offline, loaded at startup, searched with one matrix multiply.")
    ContainerDb(tokens, "Token state", ".salesmsg_tokens.json", "The rotated refresh token. Outranks .env on the next start.")
    ContainerDb(web_login, "Web-app login", ".webmcp_state.json", "Playwright storage state: cookies plus the app's localStorage token. A live credential; gitignored.")
}

System_Ext(twilio, "Twilio", "Voice, ConversationRelay, REST")
System_Ext(claude, "Claude API", "Messages API, server-side web search")
System_Ext(salesmsg, "Salesmsg MCP server", "Account tools")
System_Ext(salesmsg_as, "Salesmessage authorization server", "OAuth 2.0")
System_Ext(webapp, "Salesmessage web app", "WebMCP tools")
System_Ext(zep, "Zep", "Caller memory + catalogue graph")
System_Ext(voyage, "Voyage AI", "Embeddings")

Rel(member, twilio, "Calls, speaks, keys the PIN", "PSTN")
Rel_Back(prospect, twilio, "Is dialled", "PSTN")
Rel(operator, dialpad_ui, "Uses", "HTTPS")
Rel(operator, scripts, "Runs", "shell")

Rel(dialpad_ui, app, "POST /calls, GET /calls/{sid}, POST /calls/{sid}/hangup", "JSON/HTTPS")
Rel(twilio, app, "POST /twiml, /outbound-twiml, /handoff, /call-status, /amd-status", "HTTPS, signed")
BiRel(twilio, app, "The live call: transcribed speech in, text tokens out", "WSS /ws")
Rel(app, twilio, "Places and ends calls", "HTTPS, REST API")

Rel(app, claude, "Streams turns and tool results", "HTTPS")
Rel(app, salesmsg, "One persistent session per process, reconnected on token rotation", "MCP / streamable HTTP")
Rel(app, salesmsg_as, "refresh_token grant", "HTTPS")
Rel(app, zep, "Answering service: callers, threads, turns, recall; catalogue sync at startup", "HTTPS")
Rel(app, browser, "Answering service, after the PIN: allowlisted WebMCP tool calls", "Playwright")
Rel(browser, webapp, "Loads the app, executes its WebMCP tools", "HTTPS")
Rel(browser, web_login, "Starts from the saved login", "file")
Rel(app, voyage, "Demo dialer: embeds the query", "HTTPS")

Rel(app, features, "Reads at startup to sync Zep", "file")
Rel(app, sqlite, "Demo dialer: reads caller memory, writes transcript and summary", "sqlite3")
Rel(app, index, "Loads at startup, searches per question", "file / NumPy")
Rel(app, tokens, "Writes a rotated refresh token", "file")
Rel(app, explorer_ui, "Serves at /explore", "HTTPS")

Rel(scripts, index, "Builds from the feature catalogue and site, and visualizes")
Rel(scripts, tokens, "Seeds via the browser OAuth flow")
Rel(scripts, web_login, "Saves after a one-time interactive sign-in")
Rel(scripts, twilio, "Points a number at this app")

@enduml
