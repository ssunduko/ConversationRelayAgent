# Copy to .env and fill in. Values shown are the defaults from core/config.py
# unless marked as a placeholder (<...>).

# --- Claude -----------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max -- keep it low on a phone line
CLAUDE_EFFORT=low
# Caps thinking AND speech together; don't size it to the reply length
CLAUDE_MAX_TOKENS=2048
CLAUDE_MAX_TOOL_ITERATIONS=5
# How many times a long MCP chain may resume after stop_reason=pause_turn
CLAUDE_MAX_CONTINUATIONS=5

# --- Salesmsg MCP -----------------------------------------------------
# Streamable-HTTP endpoint; must be reachable from the public internet.
SALESMSG_MCP_URL=<salesmsg-mcp-url>

# Preferred: refresh-token credentials, so tokens renew themselves.
# Get these by running: python scripts/get_salesmsg_token.py
SALESMSG_CLIENT_ID=<client-id>
# SALESMSG_CLIENT_SECRET=<client-secret>
SALESMSG_REFRESH_TOKEN=<refresh-token>

# Fallback: a static access token. Works until it expires, then calls fail
# with a 401 that only shows up in the log. Leave commented unless testing.
# SALESMSG_MCP_TOKEN=<access-token>

# Override only if the token endpoint moves. Discoverable at
# https://app.salesmessage.com/.well-known/oauth-authorization-server
# SALESMSG_TOKEN_URL=https://api.salesmessage.com/prod/int/v5/auth/oauth/token

# --- Access control ---------------------------------------------------
# Analytics stay locked until the caller keys this in. Digits only.
# Unset means locked forever (fail closed).
ACCESS_PIN=<digits>
MAX_PIN_ATTEMPTS=3

# --- Outbound demo calls ----------------------------------------------
# The dialpad places calls from this number; it is what the person sees ring.
# Must be a Twilio number you own. E.164.
OUTBOUND_CALLER_ID=<+1XXXXXXXXXX>
OUTBOUND_ENABLED=true

# --- Knowledge base (demo calls) --------------------------------------
# Free tier at https://dashboard.voyageai.com — no card required.
VOYAGE_API_KEY=<your-voyage-api-key>
VOYAGE_MODEL=voyage-3.5
KNOWLEDGE_SITE_URL=https://salesmsg.com/
KNOWLEDGE_MAX_PAGES=60
KNOWLEDGE_TOP_K=5
# Below this cosine score a hit is usually noise; the agent defers to the demo.
KNOWLEDGE_MIN_SCORE=0.35

# --- Reporting --------------------------------------------------------
# IANA name. Resolves "yesterday"/"last week" and dates every figure.
REPORT_TIMEZONE=America/New_York

# --- Twilio -----------------------------------------------------------
# Leave unset to derive the host from each request, which survives ngrok
# handing you a new URL. Set it only for a stable deployment; scheme and
# path are stripped, so a pasted full URL is tolerated.
# PUBLIC_HOSTNAME=<your-host.example.com>
WEBSOCKET_PATH=/ws
# WELCOME_GREETING=Thanks for calling Salesmessage. ...

# --- Escalation -------------------------------------------------------
# transfer_to_human dials this. E.164.
ESCALATION_NUMBER=<+1XXXXXXXXXX>
# Caller ID for the transfer leg; defaults to the number the caller dialled.
# ESCALATION_CALLER_ID=<+1XXXXXXXXXX>
ESCALATION_TIMEOUT=30
TTS_PROVIDER=ElevenLabs
TTS_VOICE=FGY2WhTYpPnrIDTdsKH5-flash_v2_5
DTMF_DETECTION=true
# none | dtmf | speech | any
INTERRUPTIBLE=any

# Conversational Intelligence (classic). Twilio persists a transcript per call
# and runs the service's Language Operators against it.
# Note: transcripts store what was said, including any analytics the agent
# reads aloud, so check the service's redaction settings.
# INTELLIGENCE_SERVICE_SID=<GAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>

# Reject unsigned webhook requests (recommended in production)
VALIDATE_TWILIO_SIGNATURE=true
TWILIO_ACCOUNT_SID=<ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>

# --- Optional tuning (defaults shown) ---------------------------------
# OUTBOUND_RING_SECONDS=25
# DETECT_ANSWERING_MACHINE=true
# HANGUP_ON_DISCONNECT=true
# DEMO_WELCOME_GREETING=Hi there, this is the Salesmessage team calling. ...
# WELCOME_GREETING_INTERRUPTIBLE=dtmf
# REPORT_INPUT_DURING_AGENT_SPEECH=dtmf
# IGNORE_BACKCHANNEL=true
# high | medium | low
# INTERRUPT_SENSITIVITY=
# DEMO_INTERRUPT_SENSITIVITY=low
# TOOL_SEARCH_ENABLED=false
# TOOL_SEARCH_TYPE=tool_search_tool_bm25_20251119
# Comma-separated tool names, or * for the full set
# DEMO_ACCOUNT_TOOLS=salesmsg_send_sms,salesmsg_send_message,salesmsg_schedule_message,salesmsg_create_contact,salesmsg_get_contact,salesmsg_search_contacts,salesmsg_get_all_inboxes
# KNOWLEDGE_INDEX_PATH=data/knowledge.npz
# DATABASE_PATH=db/answering_service.db

# Optional: override the agent personas
# SYSTEM_PROMPT=
# DEMO_SYSTEM_PROMPT=
